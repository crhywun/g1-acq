#!name=G1 SKU Scan
#!desc=v7.13.0 下载pin与本机报告；独立扫描实现仍为pro-annual-test-v2，只采集one.google.com响应中的原有g1.*与com.google.one.*候选，保持响应原文，不含主响应脚本的Gemini扩展、映射执行、模式或响应事件；报告可查看与导出，真实旧采集版本保留；使用G1 ACQ SKU 管理时停用此模块
#!system=ios

[Rule]
# 与旧模块相同：拦截 UDP 443，作用于使用该配置的流量。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-sku-scan = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.13.0/g1-sku-scan.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.13.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
