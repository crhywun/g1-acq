#!name=G1 ACQ
#!desc=v7.13.0 SKU管理兼容入口，运行版本g1-acq-v7.13-mappings；五套模板：1 元 Pro · 月付源核对、土区20TB公开1989.99TRY、土区30TB公开2949.99TRY、Ultra三个月75p、Pro12个月90p；1元Pro用exact g1.ios.2tb.ai.m（旧Pro月付）和exact g1.ios.ai.2tb.m.ip_3mo_75p.acq（AI月付候选，尚缺官方iOS同字段绑定与实机身份）→裸com.google.gemini.2tb.ai.m.3month_ip_99p；年度/helium/20/30TB不加入1元模板；土区20TB exact g1.ios.20tb.m.v2→g1.ios.20tb.m、土区30TB exact g1.ios.30tb.ai.pro.m→g1.ios.30tb.m原模板不变，可与Pro同时使用；报告点应用才原子停用仍启用的旧prefix g1.ios.2tb.及旧exact g1.ios.20tb.m.v2→同一Gemini目标，保留其他目标、ID、顺序与历史；同match/from合并启用，缺少追加，超过30条或冲突整次不写，保存为custom；Pro12个月仍宽prefix90p，精确规则优先，切回旧前缀行为需在管理页停用两条月付exact；默认discount75保留20TB/30TB75p与g1.2tb.ai.12months_ip_90p，无.acq，fallback=false；与G1 ACQ SKU 管理只开一个入口，重新连接、点应用、重进Pro/AI月付页，卡片按当前版本/revision核对本模板及每源实际to命中，0次与未应用/等待分开，HTTP改写不证明购买调用或弹窗；PR#8旧Ultra源仅作历史引用，金额周期看App Store，价格非保证；保留手动编辑、采集、10次响应、JSON与schema1，安装/GET不迁移或清记录
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.13.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.13.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
