name: G1 ACQ
desc: 说明
version: 7.5.0
openUrl: https://one.google.com/g1-sku-report

rules:
  - AND,((PROTOCOL,UDP),(DST-PORT,443)),REJECT

http:
  script:
    - match: '^https://one\.google\.com/'
      name: g1-acq
      type: response
      require-body: true
      max-size: 10485760
      timeout: 20
    - match: '^https://one\.google\.com/g1-sku-report/?(?:\?.*)?$'
      name: g1-sku-report
      type: request
      require-body: false
      timeout: 20
  mitm:
    - one.google.com

script-providers:
  g1-acq: 
    url: https://raw.githubusercontent.com/duanxianwp/g1-acq/refs/heads/main/g1-acq.js
    interval: 86400
  g1-sku-report:
    url: https://raw.githubusercontent.com/duanxianwp/g1-acq/refs/heads/main/g1-sku-report.js
    interval: 86400
