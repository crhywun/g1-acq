name: 'G1 ACQ'
desc: |-  …v7.5.0 说明…
version: '7.5.0'
openUrl: 'https://one.google.com/g1-sku-report'   # 点卡片「打开」直达本机报告

rules:
  - 'AND,((PROTOCOL,UDP),(DST-PORT,443)),REJECT'

http:
  script:
    - match: '^https://one\.google\.com/'
      name: g1-acq
      type: response
      require-body: true
      max-size: 10485760
      timeout: 20
    - match: '^https://one\.google\.com/g1-sku-report/?(?:\?.*)?$'
      name: g1-sku-report
      type: request
      require-body: false
      timeout: 20
  mitm:
    - one.google.com

script-providers:
  g1-acq:        { url: 'https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-acq.js',        interval: 86400 }
  g1-sku-report: { url: 'https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-sku-report.js', interval: 86400 }
